{
  "name": "just-us",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Private four-person rooms, accounts and chat. Games coming later.",
  "scripts": {
    "dev": "tsx apps/server/src/index.ts --dev",
    "cloud": "tsx scripts/cloud.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/server/apps/server/src/index.js",
    "backup": "node dist/server/scripts/state-tool.js backup",
    "restore": "node dist/server/scripts/state-tool.js restore",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "supabase": "2.121.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
