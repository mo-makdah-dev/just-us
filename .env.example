# Copy to .env; never commit real credentials. Node loads it at startup.
PORT=3210
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3210
# Leave DATABASE_URL blank for built-in SQLite local experimentation.
# The default database lives under %LOCALAPPDATA%/JustUs on Windows.
# Set SQLITE_PATH to override it with a durable local path outside OneDrive.
SQLITE_PATH=
# Hosted deployments REQUIRE PostgreSQL; use a dedicated Supabase project.
DATABASE_URL=
# For a managed database whose root CA is not trusted locally, configure its CA.
# Never disable TLS certificate verification.
DATABASE_CA_FILE=
# production enables Secure cookies and requires HTTPS APP_ORIGIN + DATABASE_URL.
NODE_ENV=development
# Optional Render proxy trust: 1 for one known reverse proxy; otherwise leave 0.
TRUST_PROXY=0
# Optional Google OAuth via a free Supabase project. Username accounts work
# without these values. Configure the Google provider in Supabase first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
